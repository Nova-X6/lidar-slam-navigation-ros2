<?xml version="1.0"?>
<!--
  Simplified URDF for AgileX Scout Mini Omnidirectional
  Dimensions: 0.56m (L) x 0.49m (W) x 0.35m (H)
  Lidar mounted at top centre
-->
<robot name="scout_mini">

  <!-- Base footprint (on the ground) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Main chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.49 0.20"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.56 0.49 0.20"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="40.0"/>
      <inertia ixx="0.8" ixy="0" ixz="0"
                         iyy="0.8" iyz="0"
                                   izz="1.2"/>
    </inertial>
  </link>

  <!-- Lidar mount (Robosense RS-LiDAR on top) -->
  <joint name="base_to_rslidar" type="fixed">
    <parent link="base_link"/>
    <child  link="rslidar"/>
    <!-- 0.10 m above chassis top surface -->
    <origin xyz="0.0 0.0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="rslidar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.07"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.83"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
                           iyy="0.001" iyz="0"
                                       izz="0.001"/>
    </inertial>
  </link>

</robot>
