# Stage world file for second_project
# AgileX Scout Mini Omnidirectional simulation
#
# IMPORTANT: After running mapping (Task 1) and saving the map with map_saver,
# copy the generated map.pgm into second_project/map/.
# Then update the 'size' field below to match your map's real-world dimensions.
# Map size in metres = (image_width * resolution, image_height * resolution)
# where resolution comes from your map.yaml.

resolution 0.05          # metres per pixel (must match map resolution)
interval_sim 100         # simulation time step in ms

# ── Map bitmap (generated by slam_toolbox / map_saver) ────────────────────────
# Adjust size [W H depth] to match your actual map dimensions.
# As a placeholder, 40 x 30 m is used – replace with real values.
floorplan
(
  name "map"
  bitmap "../map/map.pgm"
  size [40.0 30.0 0.5]
  pose [0.0 0.0 0.0 0.0]
)

# ── Lidar sensor definition ───────────────────────────────────────────────────
define rslidar_2d ranger
(
  sensor
  (
    range [ 0.3 30.0 ]
    fov   360.0
    samples 720
  )
  color "SteelBlue"
  size  [ 0.11 0.11 0.07 ]
  pose  [ 0.0  0.0  0.25 0.0 ]
)

# ── AgileX Scout Mini Omnidirectional robot model ─────────────────────────────
define scout_mini position
(
  # Physical size [length width height]
  size  [ 0.56 0.49 0.20 ]

  # Centre of rotation offset
  origin [ 0.0 0.0 0.0 0.0 ]

  # Omnidirectional kinematics
  drive "omni"

  # Velocity / acceleration limits
  velocity_bounds    [-0.5 0.5  -0.5 0.5  0  0  -1.0 1.0]
  acceleration_bounds [-2.5 2.5  -2.5 2.5  0  0  -3.2 3.2]

  gui_nose 1
  color "DodgerBlue"

  # Attach the lidar
  rslidar_2d()
)

# ── Robot instance ────────────────────────────────────────────────────────────
# Starting pose [x y z theta] – must be inside a free cell of the map
scout_mini
(
  name  "robot_0"
  pose  [ 0.0 0.0 0.0 0.0 ]
  color "DodgerBlue"
)
